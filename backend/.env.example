PORT=3000
CORS_ORIGIN=http://localhost:5173
# Pino: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Azure Foundry / Azure OpenAI–compatible inference
# Use either:
# - Resource base: https://YOUR_RESOURCE.openai.azure.com (deployment name from AZURE_FOUNDRY_MODEL is used in the path), or
# - Full chat completions URL including query string if your portal shows one.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=gpt-4o-mini

# OpenAI (api.openai.com Chat Completions)
OPENAI_API_KEY=
# Optional default when the client omits model; also used if the UI model field is empty
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
